<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Timetable System</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body { background-color: #f8f9fa; }

        .navbar-brand { font-weight: 600; font-size: 1.2rem; }

        .sidebar {
            min-height: calc(100vh - 56px);
            background: #212529;
            padding-top: 1rem;
        }
        .sidebar .nav-link {
            color: #adb5bd;
            padding: 0.55rem 1.25rem;
            font-size: 0.9rem;
            border-radius: 0;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: #fff;
            background: #2c3e50;
        }
        .sidebar .nav-link i { margin-right: 8px; font-size: 1rem; }
        .sidebar .section-label {
            font-size: 0.7rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: .06em;
            padding: 1rem 1.25rem 0.3rem;
        }

        .main-content { padding: 1.8rem; }

        .card { border: none; border-radius: 0.5rem; box-shadow: 0 1px 4px rgba(0,0,0,.08); }
        .card-header { border-radius: 0.5rem 0.5rem 0 0 !important; }

        .table thead th { font-size: 0.82rem; text-transform: uppercase; letter-spacing:.04em; }
        .table tbody td { vertical-align: middle; }

        .badge-id { font-size: 0.82rem; font-weight: 500; }

        footer { font-size: 0.8rem; color: #6c757d; padding: 1rem 1.8rem; border-top: 1px solid #dee2e6; margin-top: 2rem; }
    </style>
</head>
<body>

<!-- ── Top Navbar ─────────────────────────────────────── -->
<nav class="navbar navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="/">
        <i class="bi bi-calendar3 me-2"></i>Timetable System
    </a>
    <span class="navbar-text text-secondary small">TAN College of Technology</span>
</nav>

<div class="container-fluid">
    <div class="row">

        <!-- ── Sidebar ───────────────────────────────────── -->
        <nav class="col-md-2 d-none d-md-block sidebar px-0">
            <div class="section-label">Setup</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Department"?"active":"")"
                       asp-controller="Department" asp-action="Index">
                        <i class="bi bi-building"></i>Departments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="LectureHall"?"active":"")"
                       asp-controller="LectureHall" asp-action="Index">
                        <i class="bi bi-door-open"></i>Lecture Halls
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Subject"?"active":"")"
                       asp-controller="Subject" asp-action="Index">
                        <i class="bi bi-book"></i>Subjects
                    </a>
                </li>
            </ul>

            <div class="section-label">Lecturers</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Lecturer"?"active":"")"
                       asp-controller="Lecturer" asp-action="Index">
                        <i class="bi bi-person"></i>Lecturers
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Preference"?"active":"")"
                       asp-controller="Preference" asp-action="Index">
                        <i class="bi bi-list-ol"></i>Preferences
                    </a>
                </li>
            </ul>

            <div class="section-label">Schedule</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString()=="Timetable"?"active":"")"
                       asp-controller="Timetable" asp-action="Index">
                        <i class="bi bi-calendar-week"></i>Timetable
                    </a>
                </li>
            </ul>
        </nav>

        <!-- ── Page Content ──────────────────────────────── -->
        <main class="col-md-10 main-content">
            @RenderBody()
        </main>

    </div>
</div>

<footer>
    &copy; @DateTime.Now.Year — TAN College Timetable System &nbsp;|&nbsp; ASP.NET Core 5.0 MVC
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
