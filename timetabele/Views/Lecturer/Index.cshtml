@{
    ViewData["Title"] = "Lecturers";
    var lecturers = ViewBag.Lecturers   as List<TimetableApp.Models.LecturerModel>  ?? new List<TimetableApp.Models.LecturerModel>();
    var depts     = ViewBag.Departments as List<TimetableApp.Models.DropdownItem>   ?? new List<TimetableApp.Models.DropdownItem>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-semibold"><i class="bi bi-person me-2 text-warning"></i>Lecturers</h4>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">

    @* ── Add Form ─────────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-warning text-dark py-2">
                <i class="bi bi-person-plus me-1"></i> Add Lecturer
            </div>
            <div class="card-body">
                <form asp-controller="Lecturer" asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lecturer ID <span class="text-danger">*</span></label>
                        <input type="text" name="LecturerID" class="form-control"
                               placeholder="e.g. acc/001" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control"
                               placeholder="e.g. Dr. A. Perera" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="Email" class="form-control"
                               placeholder="e.g. ramanayaka@college.lk" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="DeptID" class="form-select" required>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-warning w-100 text-dark fw-semibold">
                        <i class="bi bi-save me-1"></i> Save Lecturer
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ── List ─────────────────────────────────────────────────── *@
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-dark text-white py-2">
                <i class="bi bi-people me-1"></i> All Lecturers
                <span class="badge bg-secondary ms-2">@lecturers.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th class="text-center" style="width:140px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!lecturers.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No lecturers added yet.</td></tr>
                        }
                        @foreach (var lec in lecturers)
                        {
                            <tr>
                                <td><span class="badge bg-warning text-dark badge-id">@lec.LecturerID</span></td>
                                <td>@lec.FullName</td>
                                <td class="text-muted small">@lec.Email</td>
                                <td><span class="badge bg-light text-dark border">@lec.DeptName</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-id="@lec.LecturerID"
                                            data-name="@lec.FullName"
                                            data-email="@lec.Email"
                                            onclick="fillEdit(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-controller="Lecturer" asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @lec.FullName?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lecturerID" value="@lec.LecturerID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── Edit Modal ── *@
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Lecturer" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Lecturer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Lecturer ID</label>
                        <input type="text" id="editID" name="LecturerID" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="editName" name="FullName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" id="editEmail" name="Email" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="DeptID" class="form-select" required>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning text-dark fw-semibold"><i class="bi bi-check-lg me-1"></i>Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillEdit(btn) {
        document.getElementById('editID').value    = btn.dataset.id;
        document.getElementById('editName').value  = btn.dataset.name;
        document.getElementById('editEmail').value = btn.dataset.email;
    }
</script>
}
