@model TimetableApp.Models.SubjectModel
@{
    ViewData["Title"] = "Subjects";
    var subjects = ViewBag.Subjects     as List<TimetableApp.Models.SubjectModel>   ?? new List<TimetableApp.Models.SubjectModel>();
    var depts    = ViewBag.Departments  as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-semibold"><i class="bi bi-book me-2 text-info"></i>Subjects</h4>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2">
        <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">

    @* ── Add Form ─────────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-info text-white py-2">
                <i class="bi bi-plus-circle me-1"></i> Add Subject
            </div>
            <div class="card-body">
                <form asp-controller="Subject" asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject Code <span class="text-danger">*</span></label>
                        <input type="text" name="SubjectCode" class="form-control"
                               placeholder="e.g. AC2101"
                               oninput="this.value=this.value.toUpperCase()"
                               required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject Name <span class="text-danger">*</span></label>
                        <input type="text" name="SubjectName" class="form-control"
                               placeholder="e.g. bussines analyze" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="DeptID" class="form-select" required>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Hours / Week</label>
                        <input type="text" name="ContactHoursPerWeek" class="form-control"
                               placeholder="e.g. 3" />
                    </div>
                    <button type="submit" class="btn btn-info text-white w-100">
                        <i class="bi bi-save me-1"></i> Save Subject
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ── List ─────────────────────────────────────────────────── *@
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-dark text-white py-2">
                <i class="bi bi-list-ul me-1"></i> All Subjects
                <span class="badge bg-secondary ms-2">@subjects.Count</span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th>
                            <th>Subject Name</th>
                            <th>Department</th>
                            <th>Hrs/Wk</th>
                            <th class="text-center" style="width:140px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!subjects.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">No subjects added yet.</td></tr>
                        }
                        @foreach (var s in subjects)
                        {
                            <tr>
                                <td><span class="badge bg-info text-white badge-id">@s.SubjectCode</span></td>
                                <td>@s.SubjectName</td>
                                <td><span class="badge bg-light text-dark border">@s.DeptName</span></td>
                                <td class="text-center">@s.ContactHoursPerWeek</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-code="@s.SubjectCode"
                                            data-name="@s.SubjectName"
                                            data-hrs="@s.ContactHoursPerWeek"
                                            onclick="fillEdit(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-controller="Subject" asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @s.SubjectCode?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="subjectCode" value="@s.SubjectCode" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── Edit Modal ── *@
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Subject" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Subject</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject Code</label>
                        <input type="text" id="editCode" name="SubjectCode" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Subject Name <span class="text-danger">*</span></label>
                        <input type="text" id="editName" name="SubjectName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department <span class="text-danger">*</span></label>
                        <select name="DeptID" class="form-select" required>
                            @foreach (var d in depts)
                            {
                                <option value="@d.Value">@d.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Hours / Week</label>
                        <input type="text" id="editHrs" name="ContactHoursPerWeek" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-white"><i class="bi bi-check-lg me-1"></i>Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillEdit(btn) {
        document.getElementById('editCode').value = btn.dataset.code;
        document.getElementById('editName').value = btn.dataset.name;
        document.getElementById('editHrs').value  = btn.dataset.hrs;
    }
</script>
}
