@model List<TimetableApp.Models.DepartmentModel>
@{
    ViewData["Title"] = "Departments";
}

@* ── Page header ─────────────────────────────────────────────── *@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0 fw-semibold"><i class="bi bi-building me-2 text-primary"></i>Departments</h4>
</div>

@* ── Alert messages ───────────────────────────────────────────── *@
@if (TempData["Message"] != null)
{
    <div class="alert alert-success alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">

    @* ── Add Form ─────────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-primary text-white py-2">
                <i class="bi bi-plus-circle me-1"></i> Add Department
            </div>
            <div class="card-body">
                <form asp-controller="Department" asp-action="Save" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department ID <span class="text-danger">*</span></label>
                        <input type="text" name="DeptID" class="form-control"
                               placeholder="e.g. TAN/ACC"
                               oninput="this.value=this.value.toUpperCase()"
                               required />
                        <div class="form-text">Pattern: <strong>TAN/XX</strong> e.g. TAN/IT, TAN/SCI</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                        <input type="text" name="DeptName" class="form-control"
                               placeholder="e.g. Information Technology" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-1"></i> Save Department
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ── list table ──── *@
                    <div class="col-md-8">
                    <div class="card">
            <div class="card-header bg-dark text-white py-2">
                       <i class="bi bi-list-ul me-1"></i> All Departments
                <span class="badge bg-secondary ms-2">@Model.Count</span>
                          </div>
                        <div class="card-body p-0">
                <table class="table table-hover mb-0">
                               <thead class="table-light">
                        <tr>
                            <th>Dept ID</th>
                            <th>Department Name</th>
                            <th class="text-center" style="width:160px">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">No departments yet. Add one using the form.</td></tr>
                        }
                        @foreach (var d in Model)
                        {
                            <tr>
                                <td><span class="badge bg-primary badge-id">@d.DeptID</span></td>
                                <td>@d.DeptName</td>
                                <td class="text-center">
                                    @* Edit button opens modal *@
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal"
                                            data-id="@d.DeptID"
                                            data-name="@d.DeptName"
                                            onclick="fillEditModal(this)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @* Delete *@
                                    <form asp-controller="Department" asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @d.DeptID?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="deptID" value="@d.DeptID" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* ── Edit Modal ───────────────────────────────────────────────── *@
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Department" asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Edit Department</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department ID</label>
                        <input type="text" id="editDeptID" name="DeptID" class="form-control bg-light" readonly />
                        <div class="form-text">ID cannot be changed.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department Name <span class="text-danger">*</span></label>
                        <input type="text" id="editDeptName" name="DeptName" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function fillEditModal(btn) {
        document.getElementById('editDeptID').value   = btn.dataset.id;
        document.getElementById('editDeptName').value = btn.dataset.name;
    }
</script>
}
